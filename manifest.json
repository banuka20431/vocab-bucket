{
  "manifest_version": 3,
  "name": "Vocab-Bucket",
  "version": "1.5.0",
  "description": "Save highlighted words on any webpage and automatically fetch their meanings, pronunciations, and examples.",
  "permissions": [
    "scripting",
    "activeTab",
    "contextMenus",
    "storage",
    "downloads"
  ],
  "host_permissions": [
    "https://vocab-bucket-api.duckdns.org/*",
    "https://www.google.com/search*"
  ],
  "omnibox": {
    "keyword": "vb"
  },
  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  },
  "commands": {
    "save-to-vocab-bucket": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Save selected word to Vocab-Bucket"
    }
  },
  "action": {
    "default_icon": {
      "16": "images/icons/16.png",
      "32": "images/icons/32.png",
      "48": "images/icons/48.png",
      "128": "images/icons/128.png"
    },
    "default_popup": "popup/main.html"
  },
  "icons": {
    "16": "images/icons/16.png",
    "32": "images/icons/32.png",
    "48": "images/icons/48.png",
    "128": "images/icons/128.png"
  }
}